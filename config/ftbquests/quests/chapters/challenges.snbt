			rewards: [
				{
					id: "5F6343E6FDD56AC6"
					item: {
						components: {
							"minecraft:custom_name": "{\"italic\":false,\"text\":\"Château de la Vallée des Sept Collines de Saint-Éloi-sur-Montbrillant Grand Réserve Impériale Cuvée des Mille Étoiles Vieilles Vignes Sélection du Maître Vigneron Héritage Royal Édition Commémorative du Solstice d'Automne Millésime Exceptionnel Prestige Ultime de l'Ordre des Sommeliers de la Couronne Éternelle\"}"
							"minecraft:enchantments": {
								levels: {
									"minecraft:protection": 1
								}
								show_in_tooltip: 0b
							}
							"minecraft:lore": [
								"{\"bold\":true,\"italic\":false,\"text\":\"\\\"A vintage so prestigious that no one remembers what grapes were used.\\\"\"}"
								"{\"italic\":false,\"text\":\"Legend claims each bottle is blessed by seven sommeliers, aged beneath moonlit cathedrals, and turned exactly once every solstice by a hereditary cellar keeper.\"}"
								"{\"extra\":[{\"italic\":false,\"text\":\"Its bouquet has been described as \"},\"\\\"notes of wild berries, polished oak, forgotten promises, and the unmistakable aroma of excessive self-importance.\\\"\"],\"text\":\"\"}"
								"{\"italic\":false,\"text\":\"Collectors insist it should never be opened. Connoisseurs insist it should only be opened during celestial alignments. Most people simply use it to impress guests who are too intimidated to question whether it actually tastes any good.\"}"
							]
							"quark:rune_color": "orange"
						}
						count: 1
						id: "create_winery:bordeaux"
					}
					type: "item"
				}
				{
					id: "54B13AF0071F23B4"
					type: "xp"
					xp: 500
				}
